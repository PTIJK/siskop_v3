# Optional published Spline Code Export URL, ending in /scene.splinecode.
# Without it, the generated emerald artwork uses float + pointer parallax.
VITE_SPLINE_SCENE_URL=""
# Production public hostname without protocol or port (especially for multi-part domains).
# Example: siskop.example.co.id. Tenant workspaces use <slug>.<this-host>.
VITE_PUBLIC_APP_HOST=""
# Explicit tenant namespace and central registration/billing origin.
VITE_TENANT_BASE_DOMAIN="koperasi.inovasijayakarsa.id"
VITE_PUBLIC_APP_URL="https://siskop-d0f8c.web.app"

# Public Firebase web app configuration for Google and email/password authentication.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
