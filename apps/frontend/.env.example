# Optional published Spline Code Export URL, ending in /scene.splinecode.
# Without it, the generated emerald artwork uses float + pointer parallax.
VITE_SPLINE_SCENE_URL=""
# Production public hostname without protocol or port (especially for multi-part domains).
# Example: siskop.example.co.id. Tenant workspaces use <slug>.<this-host>.
VITE_PUBLIC_APP_HOST=""
# Explicit tenant namespace and central registration/billing origin.
VITE_TENANT_BASE_DOMAIN="koperasi.inovasijayakarsa.id"
VITE_PUBLIC_APP_URL="https://siskop-d0f8c.web.app"

# Public Firebase web app configuration for Google and email/password authentication.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# PostHog landing-page analytics (public project token, EU region). Leave the key empty to disable.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# SEO (landing page). Absolute origin of the production domain, no trailing path. Leave empty on
# staging: the build then emits noindex, a blocking robots.txt and no sitemap. See docs/seo/README.md.
SITE_URL=""
# Optional. Public pricing catalog used at build time for the pricing table, pricing.md and Offer JSON-LD.
# Defaults to $SITE_URL/api/public/pricing.
PRICING_API_URL=""
