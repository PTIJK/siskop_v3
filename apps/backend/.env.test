# Integration tests truncate tables between cases, so they run against their own
# database — never siskop_dev. Same container, same 5433 host port mapping.
# CI sets DATABASE_URL in the job environment, which takes precedence over this.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siskop_test"
JWT_SECRET="test-secret"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_EXPIRES_IN="15m"
NODE_ENV="test"
