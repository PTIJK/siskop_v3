generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id @default(cuid())
  name             String
  cooperativeId    String   @unique
  email            String   @unique
  phone            String
  address          String
  subscriptionTier String   @default("starter")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  units            CooperativeUnit[]
  users            User[]
  members          Member[]
  savingsAccounts  SavingsAccount[]
  loans            Loan[]
  transactions     Transaction[]

  @@index([isActive])
}

// Every tenant has at least one unit: a single-purpose KSP is a tenant with one,
// a koperasi serba usaha is a tenant with several. Postgres cannot express
// "at least one child row", so the invariant is enforced by provisionTenant().
model CooperativeUnit {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // KSP | KONSUMEN | PRODUSEN | JASA | PEMASARAN
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships UnitMembership[]
  savings     SavingsAccount[]
  loans       Loan[]
  entries     Transaction[]

  @@index([tenantId, isActive])
  @@index([tenantId, type])
}

model UnitMembership {
  id       String   @id @default(cuid())
  memberId String
  unitId   String
  joinedAt DateTime @default(now())

  member Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unit   CooperativeUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([memberId, unitId])
  @@index([unitId])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  phone        String
  name         String
  passwordHash String
  role         String    @default("member")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       Member?

  @@unique([tenantId, email])
  @@index([tenantId])
}

// No `unitId` here: membership is of the koperasi. Which units a member takes
// part in lives in UnitMembership, and that is what SHU distribution is
// computed against (savings/loan volume for KSP, purchase volume for Konsumen).
model Member {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String   @unique
  membershipId String
  status       String   @default("active")
  joinDate     DateTime @default(now())
  phone        String
  address      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships  UnitMembership[]
  savings      SavingsAccount[]
  loans        Loan[]

  @@unique([tenantId, membershipId])
  @@index([tenantId, status])
}

model SavingsAccount {
  id        String   @id @default(cuid())
  tenantId  String
  unitId    String
  memberId  String
  type      String // simpanan_pokok | simpanan_wajib | simpanan_sukarela
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      CooperativeUnit @relation(fields: [unitId], references: [id])
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  entries   Transaction[]

  @@unique([unitId, memberId, type])
  @@index([tenantId, unitId])
}

model Loan {
  id         String    @id @default(cuid())
  tenantId   String
  unitId     String
  memberId   String
  principal  Decimal   @db.Decimal(18, 2)
  rate       Decimal   @db.Decimal(6, 4)
  termMonths Int
  status     String    @default("active") // active | paid | defaulted
  kolClass   Int       @default(1) // 1..5 kolektibilitas
  issuedAt   DateTime  @default(now())
  dueAt      DateTime
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       CooperativeUnit @relation(fields: [unitId], references: [id])
  member     Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  entries    Transaction[]

  @@index([tenantId, unitId, status])
  @@index([tenantId, kolClass])
}

// tenantId is denormalised alongside unitId on purpose: it keeps the isolation
// predicate on a single column every query already filters, so tenant isolation
// never depends on a join being written correctly.
model Transaction {
  id               String   @id @default(cuid())
  tenantId         String
  unitId           String
  savingsAccountId String?
  loanId           String?
  direction        String // debit | credit
  amount           Decimal  @db.Decimal(18, 2)
  description      String
  referenceNo      String?
  createdAt        DateTime @default(now())

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             CooperativeUnit @relation(fields: [unitId], references: [id])
  savingsAccount   SavingsAccount? @relation(fields: [savingsAccountId], references: [id])
  loan             Loan?           @relation(fields: [loanId], references: [id])

  @@index([tenantId, unitId, createdAt])
  @@index([savingsAccountId])
  @@index([loanId])
}
