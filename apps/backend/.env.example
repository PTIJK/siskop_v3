# Host port is 5433, not the Postgres default 5432: this machine runs an
# unrelated native Postgres service on 5432. docker-compose maps 5433 -> 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siskop_dev"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"
LOG_LEVEL="debug"

# Required for self-service registration. Return URLs must be HTTPS (also in test mode).
PUBLIC_APP_URL=""
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
# Xendit webhook: POST https://<api-host>/api/onboarding/webhook
# Local-only legacy provisioning; never honored in production.
ALLOW_LEGACY_REGISTRATION=false

# Cloudflare Turnstile secret key for POST /api/public/register/:tenantSlug
# (the QR self-registration form). The value below is Turnstile's published
# "always passes" test secret — fine for local dev, never for production.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Requests/hour per IP on the same endpoint. Defaults to 5 if unset.
SELF_REGISTRATION_RATE_LIMIT_PER_HOUR=5

# Firebase Admin uses Application Default Credentials (attached service account on Cloud Run).
FIREBASE_PROJECT_ID=""
# Create staff/platform accounts in Firebase as well as PostgreSQL.
FIREBASE_ACCOUNT_PROVISIONING_ENABLED=false

# Tenant routing remains disabled until wildcard DNS and HTTPS are ready.
TENANT_BASE_DOMAIN="koperasi.inovasijayakarsa.id"
TENANT_DOMAINS_ENABLED=false
TENANT_DOMAIN_RENAME_ENABLED=false
# Enable only after the shared-identity migration and coordinated web/API rollout.
TENANT_LOGIN_SELECTION_ENABLED=false
TENANT_SWITCHING_ENABLED=false
# Server-only shared key, at least 32 characters. Use Secret Manager in production.
TENANT_GATEWAY_SECRET=""

# Shared secret for POST /api/scheduler/run-daily (x-scheduler-token header) —
# the daily interest/KOL job. In production, point one external scheduler at
# this endpoint instead of relying only on main.ts's in-process node-cron
# timer, which only runs while a given instance is up.
SCHEDULER_SECRET=""

# Optional registration confirmation email (server only; never VITE_ variables).
# Queue confirmations after verified payment; leaving these blank delays sending.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Setup: infra/firebase/RESEND.md. Resend test sender can email only your account.
