# Host port is 5433, not the Postgres default 5432: this machine runs an
# unrelated native Postgres service on 5432. docker-compose maps 5433 -> 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siskop_dev"
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"
LOG_LEVEL="debug"

# Required for self-service registration. Return URLs must be HTTPS (also in test mode).
PUBLIC_APP_URL=""
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
# Xendit webhook: POST https://<api-host>/api/onboarding/webhook
# Local-only legacy provisioning; never honored in production.
ALLOW_LEGACY_REGISTRATION=false

# Firebase Admin uses Application Default Credentials (attached service account on Cloud Run).
FIREBASE_PROJECT_ID=""

# Optional registration confirmation email (server only; never VITE_ variables).
# Queue confirmations after verified payment; leaving these blank delays sending.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Setup: infra/firebase/RESEND.md. Resend test sender can email only your account.
