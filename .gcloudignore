# Upload only the backend build inputs; never upload env files, uploads or local data.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps/
!apps/backend/
!apps/backend/Dockerfile
!apps/backend/package.json
!apps/backend/tsconfig.json
!apps/backend/src/
!apps/backend/src/**
!apps/backend/prisma/
!apps/backend/prisma/schema.prisma
!apps/backend/prisma/migrations/
!apps/backend/prisma/migrations/**
!packages/
!packages/types/
!packages/types/package.json
!packages/types/tsconfig.json
!packages/types/src/
!packages/types/src/**
!packages/eslint-config/
!packages/eslint-config/package.json
!packages/eslint-config/index.js
!infra/
!infra/firebase/
!infra/firebase/cloudbuild.yaml
**/.env*
**/node_modules/**
**/*.log
