# Database
DATABASE_URL="postgresql://siskop:siskop_password@localhost:5432/siskop_dev"

# JWT
JWT_SECRET="change-this-to-a-random-32-char-string-minimum"
JWT_REFRESH_SECRET="change-this-to-another-random-32-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Platform
PLATFORM_DOMAIN="siskop.com"
ADMIN_SUBDOMAIN="admin"
PORT=3000
NODE_ENV="development"

# Frontend
VITE_API_URL="http://localhost:3000"
VITE_PLATFORM_DOMAIN="localhost"

# OAuth (optional for v1)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Storage
STORAGE_PATH="./uploads"
MAX_FILE_SIZE_MB=2

# SMTP (optional for v1)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@siskop.com"
