# Explicit source allowlist for manual verification builds. GitHub triggers use
# the committed checkout, so local ignored credentials cannot enter those builds.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!turbo.json
!.dockerignore
!.github/
!.github/workflows/
!.github/workflows/ci.yml
!firebase.json
!apphosting.yaml
!.firebaserc
!apps/
!apps/**
!packages/
!packages/**
!infra/
!infra/firebase/
!infra/firebase/**
!infra/tenant-web/
!infra/tenant-web/**
!infra/central-gateway/
!infra/central-gateway/**
!infra/contabo/
!infra/contabo/**
**/.env*
!apps/frontend/.env.staging
**/node_modules/**
**/dist/**
**/coverage/**
**/.turbo/**
**/.pnpm-store/**
**/uploads/**
**/__pycache__/**
**/*.log
**/*.local
**/*.tsbuildinfo
apps/backend/scripts/data/**
**/*firebase-adminsdk*.json
**/*service-account*.json
